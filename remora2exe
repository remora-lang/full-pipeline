#!/usr/bin/env bash
#
# Proof of concept of the full pipeline, targeting the CPU. The existence of
# this script does not imply that shell script is a good language for writing
# compiler drivers.
#
# Like ../demo_cuda/remora2cuda and ../demo_rocm/remora2rocm, this produces a
# library rather than a program: lib<name>.a and a generated <name>.h. If the
# program has a <name>_scaffold.c next to it, that is linked against the
# library too, which is where main() lives.

set -e

if [ $# -ne 1 ]; then
    echo "Usage: $0 FILE" >&2
    exit 1
fi

# Resolved before the cd below, so relative paths still mean what the caller
# meant.
REMORA_FILE=$(realpath "$1")

cd "$(dirname "$0")"
ROOT=$PWD
OUT=$ROOT/build
mkdir -p "$OUT"

NAME=$(basename "${REMORA_FILE%.remora}")

remora futhark < "$REMORA_FILE" > "$OUT/$NAME.fut_soacs"

FUTHARK=futhark
# FUTHARK=~/Projects/mocha/futhark/dist-newstyle/build/x86_64-linux/ghc-9.10.3/futhark-0.28.0/x/futhark/build/futhark/futhark

${FUTHARK} dev -s --flatten=no_intra --no-grid -e "$OUT/$NAME.fut_soacs" \
    > "$OUT/${NAME}_opt.fut_gpu"

mlir-backend "$OUT/${NAME}_opt.fut_gpu" > "$OUT/$NAME.mlir"

# Lower to LLVM dialect, targeting the CPU. The order matters: we must get rid
# of tensors (bufferize) before linalg can become loops, and of all structured
# control flow before converting to the LLVM dialect. --llvm-request-c-wrappers
# gives us the _mlir_ciface_* entry points that the bindings call; the raw ones
# pass and return memref descriptors in a way that is not the C ABI.
#
# --buffer-deallocation-pipeline puts every dealloc at the end of the block that
# owns the buffer, which for straight-line code means nothing is freed until the
# whole program has run. --optimize-allocation-liveness moves each one just past
# its last use.
mlir-opt "$OUT/$NAME.mlir" \
  --one-shot-bufferize="bufferize-function-boundaries function-boundary-type-conversion=identity-layout-map allow-return-allocs-from-loops" \
  --buffer-deallocation-pipeline \
  --optimize-allocation-liveness \
  --convert-linalg-to-loops \
  --convert-scf-to-cf \
  --expand-strided-metadata \
  --lower-affine \
  --llvm-request-c-wrappers \
  --convert-math-to-llvm \
  --finalize-memref-to-llvm \
  --convert-func-to-llvm \
  --convert-arith-to-llvm \
  --convert-cf-to-llvm \
  --reconcile-unrealized-casts \
  -o "$OUT/${NAME}_opt.mlir"

mlir-translate --mlir-to-llvmir "$OUT/${NAME}_opt.mlir" -o "$OUT/$NAME.ll"

# Generate the C API from the entry signatures in $NAME.mlir.
"$ROOT/remora-cbindings.janet" "$OUT/$NAME.mlir" "$OUT/$NAME.h" "$OUT/${NAME}_bindings.c"

# The library: compiled program, its bindings, the shared runtime, and the
# allocator behind the caller's arrays. No GPU pass here needs a static
# destructor stripped, unlike the GPU drivers.
clang -c "$OUT/$NAME.ll" -o "$OUT/$NAME.o" -Wno-unused-command-line-argument
for src in "$OUT/${NAME}_bindings.c" "$ROOT/runtime/remora_runtime.c" \
           "$ROOT/runtime/mlir_cpu_alloc.c"; do
    clang -c "$src" -Wall -Wextra -I"$OUT" -I"$ROOT/runtime" \
        -o "$OUT/$(basename "${src%.c}").o"
done

rm -f "$OUT/lib$NAME.a"
ar rcs "$OUT/lib$NAME.a" \
    "$OUT/$NAME.o" "$OUT/${NAME}_bindings.o" "$OUT/remora_runtime.o" \
    "$OUT/mlir_cpu_alloc.o"

# The generated code calls libm (powf and friends) and MLIR's C runner utilities
# (memrefCopy), which live next to the toolchain's binaries.
MLIR_LIB=$(dirname "$(command -v mlir-opt)")/../lib
LINK_FLAGS="-L$MLIR_LIB -Wl,-rpath,$MLIR_LIB -lmlir_c_runner_utils -lm"

echo "built $OUT/lib$NAME.a and $OUT/$NAME.h" >&2
echo "link with: clang yourprogram.c $OUT/lib$NAME.a -I$OUT $LINK_FLAGS" >&2

# Build the scaffolding too, if this program has any.
SCAFFOLD=$(dirname "$REMORA_FILE")/${NAME}_scaffold.c
if [ -e "$SCAFFOLD" ]; then
    # shellcheck disable=SC2086
    clang "$SCAFFOLD" "$OUT/lib$NAME.a" -Wall -Wextra -I"$OUT" $LINK_FLAGS \
        -o "$OUT/$NAME"
    echo "built $OUT/$NAME from $(basename "$SCAFFOLD")" >&2
fi
